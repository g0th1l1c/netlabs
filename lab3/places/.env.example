# Скопируйте этот файл в .env и впишите свои ключи.
# Файл .env не попадает в git (см. .gitignore).

# https://www.graphhopper.com/  (Geocoding API)
GRAPHHOPPER_KEY=
# https://openweathermap.org/api  (Current Weather)
OPENWEATHER_KEY=
# https://opentripmap.io/product  (Places API)
OPENTRIPMAP_KEY=

# Необязательные настройки (значения по умолчанию указаны):
# PLACES_RADIUS_M=1000        радиус поиска интересных мест, метры
# PLACES_LIMIT=10             сколько мест показывать
# PLACES_PARALLEL=5           сколько описаний запрашивать одновременно
# HTTP_TIMEOUT_SEC=10         таймаут одного HTTP-запроса
